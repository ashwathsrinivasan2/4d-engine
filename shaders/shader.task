#version 460
#extension GL_EXT_mesh_shader : require

layout(binding = 0) uniform UniformBufferObject{
    mat4 view;
    vec4 viewTranslate;

    mat4 proj;
} ubo;

struct InstanceData{
    mat4 model;
    vec4 modelTranslate;
};

struct Vertex {
    vec4 position;
    vec4 color;
    vec4 normal;
    vec4 texCoord;
    uvec4 instanceID;
};

struct TaskPayload{
    vec4 hyperPlaneSides;
    
    mat4 model;
    vec4 modelTranslate;

    mat4 view;
    vec4 viewTranslate;

    mat4 proj;

    int numTriangles;
    Vertex vertices[4];
    
};

layout(std430, binding = 1) readonly buffer VertexSSBO {
   Vertex vertexData[ ];
};

layout(std430, binding = 2) readonly buffer InstanceDataSSBO {
   InstanceData instanceData[ ];
};

layout(local_size_x = 1) in;

taskPayloadSharedEXT TaskPayload payload;

bool intersectsPlane(vec4 sides){
    bool hasPos = sides.x > 0.0 || sides.y > 0.0 || sides.z > 0.0 || sides.w > 0.0;
    bool hasNeg = sides.x < 0.0 || sides.y < 0.0 || sides.z < 0.0 || sides.w < 0.0;
    return hasPos && hasNeg;
}

int sum(vec4 sides){
    int sum = 0;
    for(int i = 0; i < 4; i++){
        sum += int(sides[i]);
    }

    return sum;
}



void main(){
    uint index = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;

    //figure out which side of hyperplane each vertex is on
    uint currInstance = vertexData[4 * index].instanceID.x;
    vec4 hyperPlaneSide;
    for(int i = 0; i < 4; i++){
        vec4 transformedPos = ubo.view * (instanceData[currInstance].model * vertexData[4 * index + i].position + instanceData[currInstance].modelTranslate + ubo.viewTranslate);
        hyperPlaneSide[i] = sign(transformedPos.w);
    }


        for(int i = 0; i < 4; i++){
            payload.vertices[i] = vertexData[4 * index + i];
        }


        payload.model = instanceData[currInstance].model;
        payload.modelTranslate = instanceData[currInstance].modelTranslate;
        payload.view = ubo.view;
        payload.viewTranslate = ubo.viewTranslate;
        payload.proj = ubo.proj;

        payload.hyperPlaneSides = hyperPlaneSide;

        payload.numTriangles = sum(hyperPlaneSide) == 0 ? 2 : 1;
        payload.numTriangles = 1;

        EmitMeshTasksEXT(intersectsPlane(hyperPlaneSide) ? 1 : 0, 1, 1);


}