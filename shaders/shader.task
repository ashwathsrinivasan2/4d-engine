#version 460
#extension GL_EXT_mesh_shader : require


struct InstanceData{
    mat4 model;
    vec4 modelTranslate;
};

struct Vertex {
    vec4 position;
    vec4 color;
    vec4 normal;
    vec4 texCoord;
    uvec4 instanceID;
};

struct TaskPayload{
    uint numTriangles[64];
    uint indices[64];
    vec4 hyperPlaneSides[64];
};



layout(binding = 0) uniform UniformBufferObject{
    mat4 view;
    vec4 viewTranslate;
    mat4 proj;
    uint numTetrahedrons;
} ubo;

layout(std430, binding = 1) readonly buffer VertexSSBO {
   Vertex vertexData[ ];
};

layout(std430, binding = 2) readonly buffer InstanceDataSSBO {
   InstanceData instanceData[ ];
};



layout(local_size_x = 64) in;



taskPayloadSharedEXT TaskPayload payload;

shared uint currIndex;



bool intersectsPlane(vec4 sides){
    bool hasPos = sides.x >= 0.0 || sides.y >= 0.0 || sides.z >= 0.0 || sides.w >= 0.0;
    bool hasNeg = sides.x <= 0.0 || sides.y <= 0.0 || sides.z <= 0.0 || sides.w <= 0.0;
    return hasPos && hasNeg;
}

int sum(vec4 sides){
    int sum = 0;
    for(int i = 0; i < 4; i++){
        sum += int(sides[i]);
    }

    return sum;
}

vec4 getTetrahedronNormal(vec4 positions[4]){
    vec4 sideVectors[3];
    for(int i = 1; i < 4; i++){
        sideVectors[i - 1] = positions[0] - positions[i];
    }

    mat3 subMatrices[4];

    for(int k = 0; k < 4; k++){
        for(int i = 0; i < 3; i++){
            int col = 0;
            for(int j = 0; j < 4; j++){
                    subMatrices[k][i][col] = j != k ? sideVectors[i][j] : subMatrices[k][i][col];
                    col += j != k ? 1 : 0;
            }
        }
    }

    vec4 normal;

    for(int i = 0; i < 4; i++){
        normal[i] = (i % 2 == 0 ? 1.0 : -1.0) * determinant(subMatrices[i]);
    }

    return normal;
}



void main(){
    uint index = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;

    if(gl_LocalInvocationID.x == 0){
        currIndex = 0;
    }

    barrier();

    if(index < ubo.numTetrahedrons){

        //figure out which side of hyperplane each vertex is on
        uint currInstance = vertexData[4 * index].instanceID.x;
        vec4 hyperPlaneSide;
        vec4 viewPos[4];

        mat4 model = instanceData[currInstance].model;
        vec4 modelTranslate = instanceData[currInstance].modelTranslate;

        for(int i = 0; i < 4; i++){
            viewPos[i] = ubo.view * ((model * vertexData[4 * index + i].position + modelTranslate) + ubo.viewTranslate);
            hyperPlaneSide[i] = sign(viewPos[i].w) >= 0.f ? 1.f : -1.f;
        }

        vec4 avgViewPos = (viewPos[0] + viewPos[1] + viewPos[2] + viewPos[3]) / 4.f;

        bool visible = intersectsPlane(hyperPlaneSide) && (dot(-avgViewPos, getTetrahedronNormal(viewPos)) > 0.f);

        if(visible){
            uint threadIndex = atomicAdd(currIndex, 1);

            if(threadIndex < 64){
                payload.hyperPlaneSides[threadIndex] = hyperPlaneSide;
                int posCount = 0;
                int negCount = 0;
                for(int i = 0; i < 4; i++){
                    posCount += hyperPlaneSide[i] > 0.f ? 1 : 0;
                    negCount += hyperPlaneSide[i] <= 0.f ? 1 : 0;
                }
                payload.numTriangles[threadIndex] = (posCount == 2 && negCount == 2) ? 2 : 1;
                payload.indices[threadIndex] = 4 * int(index);
            }
        }
    }

    memoryBarrierShared();
    barrier();

    if(gl_LocalInvocationID.x == 0){
        EmitMeshTasksEXT(min(currIndex, 64), 1, 1);
    }

}