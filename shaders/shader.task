#version 460
#extension GL_EXT_mesh_shader : require

layout(binding = 0) uniform UniformBufferObject{
    mat4 view;
    vec4 viewTranslate;

    mat4 proj;
} ubo;

struct InstanceData{
    mat4 model;
    vec4 modelTranslate;
};

struct Vertex {
    vec4 position;
    vec4 color;
    vec4 normal;
    vec4 texCoord;
    uvec4 instanceID;
};

struct TaskPayload{
    vec4 hyperPlaneSides;
    
    mat4 model;
    vec4 modelTranslate;

    mat4 view;
    vec4 viewTranslate;

    mat4 proj;

    int numTriangles;
    Vertex vertices[4];
    
};

layout(std430, binding = 1) readonly buffer VertexSSBO {
   Vertex vertexData[ ];
};

layout(std430, binding = 2) readonly buffer InstanceDataSSBO {
   InstanceData instanceData[ ];
};

layout(local_size_x = 1) in;

taskPayloadSharedEXT TaskPayload payload;

bool intersectsPlane(vec4 sides){
    bool hasPos = sides.x > 0.0 || sides.y > 0.0 || sides.z > 0.0 || sides.w > 0.0;
    bool hasNeg = sides.x < 0.0 || sides.y < 0.0 || sides.z < 0.0 || sides.w < 0.0;
    return hasPos && hasNeg;
}

int sum(vec4 sides){
    int sum = 0;
    for(int i = 0; i < 4; i++){
        sum += int(sides[i]);
    }

    return sum;
}

vec4 getTetrahedronNormal(vec4 positions[4]){
    vec4 sideVectors[3];
    for(int i = 1; i < 4; i++){
        sideVectors[i] = positions[0] - positions[i];
    }

    mat3 subMatrices[4];

    for(int k = 0; k < 4; k++){
        for(int i = 0; i < 3; i++){
            int col = 0;
            for(int j = 0; j < 4; j++){
                    subMatrices[k][i][col] = j != k ? sideVectors[i][j] : subMatrices[k][i][col];
                    col += j != k ? 1 : 0;
            }
        }
    }

    vec4 normal;

    for(int i = 0; i < 4; i++){
        normal[i] = (i % 2 == 0 ? 1.0 : -1.0) * determinant(subMatrices[i]);
    }

    return normal;
}



void main(){
    uint index = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;

    //figure out which side of hyperplane each vertex is on
    uint currInstance = vertexData[4 * index].instanceID.x;
    vec4 hyperPlaneSide;
    vec4 viewPos[4];
    for(int i = 0; i < 4; i++){
        viewPos[i] = ubo.view * (instanceData[currInstance].model * vertexData[4 * index + i].position + instanceData[currInstance].modelTranslate + ubo.viewTranslate);
        hyperPlaneSide[i] = sign(viewPos[i].w);
    }


        for(int i = 0; i < 4; i++){
            payload.vertices[i] = vertexData[4 * index + i];
        }


        payload.model = instanceData[currInstance].model;
        payload.modelTranslate = instanceData[currInstance].modelTranslate;
        payload.view = ubo.view;
        payload.viewTranslate = ubo.viewTranslate;
        payload.proj = ubo.proj;

        payload.hyperPlaneSides = hyperPlaneSide;

        int posCount = 0;
        int negCount = 0;
        for(int i = 0; i < 4; i++){
            posCount += hyperPlaneSide[i] > 0.f ? 1 : 0;
            negCount += hyperPlaneSide[i] < 0.f ? 1 : 0;
        }
        payload.numTriangles = (posCount == 2 && negCount == 2) ? 2 : 1;

        vec4 avgViewPos = (viewPos[0] + viewPos[1] + viewPos[2] + viewPos[3]) / 4.f;

        bool visible = intersectsPlane(hyperPlaneSide);// && (dot(-avgViewPos, getTetrahedronNormal(viewPos)) > 0.f);

        EmitMeshTasksEXT(visible ? 1 : 0, 1, 1);


}