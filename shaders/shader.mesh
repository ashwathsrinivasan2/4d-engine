#version 460
#extension GL_EXT_mesh_shader : require



layout(local_size_x = 1) in;
layout(triangles, max_vertices = 4, max_primitives = 3) out;

struct Vertex {
    vec4 position;
    vec4 color;
    vec4 normal;
    vec4 texCoord;
    uvec4 instanceID;
};

struct TaskPayload{
    vec4 hyperPlaneSides;
    
    mat4 model;
    vec4 modelTranslate;

    mat4 view;
    vec4 viewTranslate;
    
    mat4 proj;
    
    int numTriangles;
    Vertex vertices[4];
};

taskPayloadSharedEXT TaskPayload payload;

layout(location = 0) out vec4 outColor[];
layout(location = 1) out vec4 outNormal[];
layout(location = 2) out vec4 outTexCoord[];
layout(location = 3) out vec4 outWorldPos[];

Vertex getInterpolatedVertex(int firstIndex, int secondIndex, out vec4 worldPos){

    //get vertices to interpolate between
    Vertex vA = payload.vertices[firstIndex];
    Vertex vB = payload.vertices[secondIndex];

    vec4 aWorld = payload.model * vA.position + payload.modelTranslate;
    vec4 bWorld = payload.model * vB.position + payload.modelTranslate;

    vec4 aPos = payload.view * (aWorld + payload.viewTranslate);
    vec4 bPos = payload.view * (bWorld + payload.viewTranslate);


    //get vertex differences for each attribute
    vec4 posDiff = bPos - aPos;
    vec4 normalDiff = vB.normal - vA.normal;
    vec4 colorDiff = vB.color - vA.color;
    vec4 texDiff = vB.texCoord - vA.texCoord;
    vec4 worldDiff = bWorld - aWorld;

    //how far on line segment to intersect
    float interpolationFactor = -aPos.w / posDiff.w;

    //calculate interpolated attributes
    vec4 interpolatedPos = aPos + interpolationFactor * posDiff;
    vec4 interpolatedColor = vec4((vA.color + interpolationFactor * colorDiff).xyz, 1.f);
    vec4 interpolatedNormal = vA.normal + interpolationFactor * normalDiff;
    vec4 interpolatedTexCoord = (vA.texCoord + interpolationFactor * texDiff);
    worldPos = aWorld + interpolationFactor * worldDiff;

    //create new 3D point from interpolated attributes
    Vertex interpolatedPoint;
    interpolatedPoint.position = interpolatedPos;
    interpolatedPoint.color = interpolatedColor;
    interpolatedPoint.normal = interpolatedNormal;
    interpolatedPoint.texCoord = interpolatedTexCoord;

    return interpolatedPoint;
}

uvec3 getSecondTriangleIndices(Vertex interpolatedVertices[4]){
    vec4 midPointA = (interpolatedVertices[0].position + interpolatedVertices[1].position) / 2.f;
    vec4 midPointB = (interpolatedVertices[1].position + interpolatedVertices[2].position) / 2.f;
    vec4 midPointC = (interpolatedVertices[2].position + interpolatedVertices[0].position) / 2.f;

    float distanceA = length(midPointA - interpolatedVertices[3].position);
    float distanceB = length(midPointB - interpolatedVertices[3].position);
    float distanceC = length(midPointC - interpolatedVertices[3].position);

    uint min = 0;
    min = (distanceB < distanceA && distanceB < distanceC) ? 1 : min;
    min = (distanceC < distanceB && distanceC < distanceA) ? 2 : min;

    return uvec3(min, 3, (min + 1) % 3);
}


void main(){

    Vertex interpolatedVertices[4];
    vec4 worldPositions[4];
    SetMeshOutputsEXT(payload.numTriangles + 2, payload.numTriangles);
    
    
    //calculate interpolated vertex for vertices on opposite sides of hyperplane
    
    int currIndex = 0;
    for(int i = 0; i < 3; i++){
        for(int j = i + 1; j < 4; j++){
            currIndex = currIndex >= 4 ? 3 : currIndex;
            interpolatedVertices[currIndex] = int(payload.hyperPlaneSides[i]) * int(payload.hyperPlaneSides[j]) == -1 ? getInterpolatedVertex(i, j, worldPositions[currIndex]) : interpolatedVertices[currIndex];
            currIndex = int(payload.hyperPlaneSides[i]) * int(payload.hyperPlaneSides[j]) == -1 ? currIndex + 1 : currIndex;
        }
    }

    
    for(int i = 0; i < currIndex; i++){
        gl_MeshVerticesEXT[i].gl_Position = payload.proj * vec4(interpolatedVertices[i].position.xyz, 1.f);
        outNormal[i]   = transpose(inverse(payload.model)) * interpolatedVertices[i].normal;
        outColor[i]    = interpolatedVertices[i].color;
        outTexCoord[i] = interpolatedVertices[i].texCoord;
        outWorldPos[i] = worldPositions[i];
    }
    

    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2); 
    gl_PrimitiveTriangleIndicesEXT[1] = getSecondTriangleIndices(interpolatedVertices);


}