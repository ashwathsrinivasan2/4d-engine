#version 460
#extension GL_EXT_mesh_shader : require



struct InstanceData{
    mat4 model;
    vec4 modelTranslate;
};

struct Vertex {
    vec4 position;
    vec4 color;
    vec4 normal;
    vec4 texCoord;
    uvec4 instanceID;
};

struct TaskPayload{
    uint numTriangles[64];
    uint indices[64];
    vec4 hyperPlaneSides[64];
};



layout(binding = 0) uniform UniformBufferObject{
    mat4 view;
    vec4 viewTranslate;
    mat4 proj;
    uint numTetrahedrons;
} ubo;

layout(std430, binding = 1) buffer VertexSSBO {
   Vertex vertexData[ ];
};

layout(std430, binding = 2) readonly buffer InstanceDataSSBO {
   InstanceData instanceData[ ];
};



layout(local_size_x = 1) in;

layout(triangles, max_vertices = 4, max_primitives = 2) out;



taskPayloadSharedEXT TaskPayload payload;

layout(location = 0) out vec4 outColor[];
layout(location = 1) out vec4 outNormal[];
layout(location = 2) out vec4 outTexCoord[];
layout(location = 3) out vec4 outWorldPos[];

Vertex getInterpolatedVertex(uint firstIndex, uint secondIndex, mat4 model, vec4 modelTranslate, out vec4 worldPos){

    //get vertices to interpolate between
    Vertex vA = vertexData[firstIndex];
    Vertex vB = vertexData[secondIndex];

    vec4 aWorld = model * vA.position + modelTranslate;
    vec4 bWorld = model * vB.position + modelTranslate;

    vec4 aPos = ubo.view * (aWorld + ubo.viewTranslate);
    vec4 bPos = ubo.view * (bWorld + ubo.viewTranslate);


    //get vertex differences for each attribute
    vec4 posDiff = bPos - aPos;
    vec4 normalDiff = vB.normal - vA.normal;
    vec4 colorDiff = vB.color - vA.color;
    vec4 texDiff = vB.texCoord - vA.texCoord;
    vec4 worldDiff = bWorld - aWorld;

    if(abs(posDiff.w) < 0.0001){
    return vA; // edge parallel to hyperplane
}

    //how far on line segment to intersect
    float interpolationFactor = -aPos.w / posDiff.w;

    //calculate interpolated attributes
    vec4 interpolatedPos = aPos + interpolationFactor * posDiff;
    vec4 interpolatedColor = vec4((vA.color + interpolationFactor * colorDiff).xyz, 1.f);
    vec4 interpolatedNormal = vA.normal + interpolationFactor * normalDiff;
    vec4 interpolatedTexCoord = (vA.texCoord + interpolationFactor * texDiff);
    worldPos = aWorld + interpolationFactor * worldDiff;

    //create new 3D point from interpolated attributes
    Vertex interpolatedPoint;
    interpolatedPoint.position = interpolatedPos;
    interpolatedPoint.color = interpolatedColor;
    interpolatedPoint.normal = interpolatedNormal;
    interpolatedPoint.texCoord = interpolatedTexCoord;

    return interpolatedPoint;
}

void main(){
    Vertex interpolatedVertices[4];
    vec4 worldPositions[4];

    uint culledIndex = gl_WorkGroupID.x;


    if(payload.numTriangles[culledIndex] < 1){
        SetMeshOutputsEXT(0, 0);
        return;
    }
    SetMeshOutputsEXT(payload.numTriangles[culledIndex] + 2, payload.numTriangles[culledIndex]);
    
    uint index = payload.indices[culledIndex];
    uint instanceID = vertexData[index].instanceID.x;
    mat4 model = instanceData[instanceID].model;
    vec4 modelTranslate = instanceData[instanceID].modelTranslate;
    vec4 hyperPlaneSide = payload.hyperPlaneSides[gl_WorkGroupID.x];

    
    

    uint currIndex = 0;
    for(uint i = 0; i < 3 && currIndex < 4; i++){
        for(uint j = i + 1; j < 4 && currIndex < 4; j++){
           
            if(hyperPlaneSide[i] * hyperPlaneSide[j] < 0.f){
                interpolatedVertices[currIndex] = getInterpolatedVertex(index + i, index + j, model, modelTranslate, worldPositions[currIndex]);
                currIndex++;
            }
        }
    }

    
    for(uint i = 0; i < currIndex; i++){
        gl_MeshVerticesEXT[i].gl_Position = ubo.proj * vec4(interpolatedVertices[i].position.xyz, 1.f);
        outNormal[i]   = transpose(inverse(model)) * interpolatedVertices[i].normal;
        outColor[i]    = interpolatedVertices[i].color;
        outTexCoord[i] = interpolatedVertices[i].texCoord;
        outWorldPos[i] = worldPositions[i];
    }

    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    gl_PrimitiveTriangleIndicesEXT[1] = uvec3(1, 3, 2); 


}